# ==============================================================================
# Kitten Medical Imaging AI Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure the credentials for your local environment:
#   cp .env.example .env
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend Configuration (Vite)
VITE_API_URL=http://localhost:8000

# MedGemma 27B Local Microservice (Optional - when running medgemma_service.py)
MEDGEMMA_URL=http://localhost:8001

# Clinical AI / LLM Providers (Optional for Copilot & Second-Opinion Reasoning)
# Google Gemini API (Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=

# Anthropic Claude API (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# OpenAI API (GPT-4o)
OPENAI_API_KEY=

# OpenFDA Drug & Device Search API (Optional)
OPENFDA_API_KEY=
